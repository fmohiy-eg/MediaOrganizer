# API credentials — copy to ".env" (gitignored) and fill in, OR set as real
# environment variables. These take precedence over any keys in config.yaml.
# Precedence per key: process environment > .env file > config.yaml.
# The .env file is looked up next to your config.yaml.

# TMDB (movies) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# TVDB v4 (TV) — https://thetvdb.com/api-information
TVDB_API_KEY=

# OpenSubtitles (subtitle fetch) — https://www.opensubtitles.com/en/consumers
OPENSUBTITLES_API_KEY=
# Username/password are optional here; the dashboard can also log in interactively.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
